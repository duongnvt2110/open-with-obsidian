#!/usr/bin/env bash

set -u
set -o pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
REPOSITORY_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)

. "$SCRIPT_DIR/lib/common.sh"
harness_normalize_locale
. "$SCRIPT_DIR/lib/package.sh"
. "$SCRIPT_DIR/lib/store.sh"
. "$SCRIPT_DIR/lib/test_selection.sh"
. "$SCRIPT_DIR/lib/inventory_policy.sh"
. "$SCRIPT_DIR/lib/project_contract.sh"
. "$SCRIPT_DIR/lib/identity.sh"
. "$SCRIPT_DIR/lib/toolchain.sh"
. "$SCRIPT_DIR/lib/policy.sh"
. "$SCRIPT_DIR/lib/conventions.sh"
. "$SCRIPT_DIR/lib/workflow.sh"
. "$SCRIPT_DIR/lib/understanding.sh"
. "$SCRIPT_DIR/lib/task.sh"
. "$SCRIPT_DIR/lib/context.sh"
. "$SCRIPT_DIR/lib/attestation.sh"
. "$SCRIPT_DIR/lib/verify.sh"
. "$SCRIPT_DIR/lib/audit.sh"

harness_init_paths "$REPOSITORY_ROOT"
HARNESS_EXECUTED_PACKAGE_DIGEST=$(package_tree_digest "$REPOSITORY_ROOT" installed) || harness_die 6 "installed package integrity validation failed"
if [ -n "${HARNESS_DECLARED_PACKAGE_DIGEST:-}" ] && [ "$HARNESS_DECLARED_PACKAGE_DIGEST" != "$HARNESS_EXECUTED_PACKAGE_DIGEST" ]; then
    harness_die 6 "declared package bytes differ from executed package bytes"
fi
export HARNESS_EXECUTED_PACKAGE_DIGEST
trap cleanup_common EXIT INT TERM

