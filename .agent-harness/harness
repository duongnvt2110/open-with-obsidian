}


validate_cli_option_arity() {
    local option
    while [ "$#" -gt 0 ]; do
        option=$1
        case "$option" in
            --json|--final|--inspection-current|--full|--force-lock|--strict|--verbose|--details|--explain) shift ;;
            --*) [ "$#" -ge 2 ] || harness_die 2 "$option requires a value"; shift 2 ;;
            *) shift ;;
        esac
    done
}

strip_json_flag() {
    FILTERED_ARGS=()
    for item in "$@"; do
        if [ "$item" = "--json" ]; then HARNESS_JSON_MODE=1; else FILTERED_ARGS+=("$item"); fi
    done
}

task_create_cli() {
    local title goal stakeholders profile project_mode risk criteria scopes reads checks coverage criterion_id description old_ifs ac check evidence rationale result status task_id run_id IFS
    IFS=$' \t\n'
    title=""; goal=""; stakeholders=""; profile="bugfix"; project_mode="brownfield"; risk="medium"
    criteria=$(mktemp "${TMPDIR:-/tmp}/criteria.XXXXXX") || harness_die 2 "cannot create temporary file"
    scopes=$(mktemp "${TMPDIR:-/tmp}/scopes.XXXXXX") || harness_die 2 "cannot create temporary file"
    reads=$(mktemp "${TMPDIR:-/tmp}/reads.XXXXXX") || harness_die 2 "cannot create temporary file"
    checks=$(mktemp "${TMPDIR:-/tmp}/checks.XXXXXX") || harness_die 2 "cannot create temporary file"
    coverage=$(mktemp "${TMPDIR:-/tmp}/coverage.XXXXXX") || harness_die 2 "cannot create temporary file"
    : >"$criteria"; : >"$scopes"; : >"$reads"; : >"$checks"; : >"$coverage"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --title) [ "$#" -ge 2 ] || harness_die 2 "--title requires a value"; title=$2; shift 2 ;;
            --goal) [ "$#" -ge 2 ] || harness_die 2 "--goal requires a value"; goal=$2; shift 2 ;;
            --stakeholders) [ "$#" -ge 2 ] || harness_die 2 "--stakeholders requires a value"; stakeholders=$2; shift 2 ;;
            --profile) [ "$#" -ge 2 ] || harness_die 2 "--profile requires a value"; profile=$2; shift 2 ;;
            --project-mode) [ "$#" -ge 2 ] || harness_die 2 "--project-mode requires a value"; project_mode=$2; shift 2 ;;
            --risk) [ "$#" -ge 2 ] || harness_die 2 "--risk requires a value"; risk=$2; shift 2 ;;
            --criterion)
                [ "$#" -ge 2 ] || harness_die 2 "--criterion requires ID|description"
                criterion_id=${2%%|*}; description=${2#*|}
                [ "$criterion_id" != "$2" ] || harness_die 2 "criterion must use ID|description"
                printf '%s\t%s\n' "$criterion_id" "$(printf '%s' "$description" | tr '\t\r\n' '   ')" >>"$criteria"
                shift 2 ;;
            --scope) [ "$#" -ge 2 ] || harness_die 2 "--scope requires a value"; printf '%s\n' "$2" >>"$scopes"; shift 2 ;;
            --read) [ "$#" -ge 2 ] || harness_die 2 "--read requires a value"; printf '%s\n' "$2" >>"$reads"; shift 2 ;;
            --check) [ "$#" -ge 2 ] || harness_die 2 "--check requires a command ID"; printf '%s\n' "$2" >>"$checks"; shift 2 ;;
            --coverage)
                [ "$#" -ge 2 ] || harness_die 2 "--coverage requires AC|CHECK|EVIDENCE|rationale"
                old_ifs=$IFS; IFS='|' read -r ac check evidence rationale <<EOF_COVERAGE
$2
EOF_COVERAGE
                IFS=$old_ifs
                [ -n "$ac" ] && [ -n "$check" ] && [ -n "$evidence" ] && [ -n "$rationale" ] || harness_die 2 "invalid coverage value"
                printf '%s\t%s\t%s\t%s\n' "$ac" "$check" "$evidence" "$(printf '%s' "$rationale" | tr '\t\r\n' '   ')" >>"$coverage"
                shift 2 ;;
            *) harness_die 2 "unknown task create option: $1" ;;
        esac
    done
    [ -n "$(trim_space "$title")" ] || harness_die 2 "title is required"
    [ -n "$(trim_space "$goal")" ] || harness_die 2 "goal is required"
    [ -n "$(trim_space "$stakeholders")" ] || harness_die 2 "stakeholders are required"
    case "$project_mode" in brownfield|greenfield) ;; *) harness_die 2 "invalid project mode" ;; esac
    case "$risk" in low|medium|high|critical) ;; *) harness_die 2 "invalid risk" ;; esac
    [ -s "$reads" ] || cp "$scopes" "$reads"
    acquire_lock "$HARNESS_GLOBAL_LOCK" task-create || harness_die 3 "another harness operation is running"
    result=$(task_create_from_files "$title" "$goal" "$stakeholders" "$profile" "$criteria" "$scopes" "$reads" "$checks" "$coverage" "" "$project_mode" "$risk")
    status=$?
    release_lock
    rm -f "$criteria" "$scopes" "$reads" "$checks" "$coverage"
    case "$status" in
        0) task_id=$(printf '%s' "$result" | awk -F '\t' '{print $1}'); run_id=$(printf '%s' "$result" | awk -F '\t' '{print $2}') ;;
        2) harness_die 3 "an active task already exists" ;;
        3) harness_die 2 "the task contract is invalid" ;;
        *) harness_die 4 "task creation failed" ;;
    esac
    if [ "$HARNESS_JSON_MODE" = "1" ]; then
        printf '{"task_id":"%s","run_id":"%s","state":"INTAKE"}\n' "$(json_escape "$task_id")" "$(json_escape "$run_id")"
    else
        printf 'Created task %s with run %s\n' "$task_id" "$run_id"
    fi
}

task_understand_cli() {
    local approved_by current_behavior entry_points data_flow dependencies interface_impact compatibility_risk scope_rationale check_rationale rollback_plan security_impact data_impact operational_impact nfr_impact
    local modules assumptions steps evidence module_seq assumption_seq step_seq evidence_seq inspection_mode inspection_skip old_ifs module_id rationale statement assumption_status claim_type claim_path claim_symbol claim_rationale task_id run_id
    approved_by=""; current_behavior=""; entry_points=""; data_flow=""; dependencies=""; interface_impact=""
    compatibility_risk=""; scope_rationale=""; check_rationale=""; rollback_plan=""; security_impact=""
    data_impact=""; operational_impact=""; nfr_impact=""; inspection_mode=""; inspection_skip=""
    modules=$(mktemp "${TMPDIR:-/tmp}/understanding-modules.XXXXXX") || harness_die 2 "cannot create modules input"
    assumptions=$(mktemp "${TMPDIR:-/tmp}/understanding-assumptions.XXXXXX") || harness_die 2 "cannot create assumptions input"
    steps=$(mktemp "${TMPDIR:-/tmp}/understanding-steps.XXXXXX") || harness_die 2 "cannot create steps input"
    evidence=$(mktemp "${TMPDIR:-/tmp}/understanding-evidence.XXXXXX") || harness_die 2 "cannot create evidence input"
    : >"$modules"; : >"$assumptions"; : >"$steps"; : >"$evidence"
    module_seq=0; assumption_seq=0; step_seq=0; evidence_seq=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --by) [ "$#" -ge 2 ] || harness_die 2 "--by requires a value"; approved_by=$2; shift 2 ;;
            --current-behavior) current_behavior=$2; shift 2 ;;
            --entry-points) entry_points=$2; shift 2 ;;
            --data-flow) data_flow=$2; shift 2 ;;
            --dependencies) dependencies=$2; shift 2 ;;
            --interface-impact) interface_impact=$2; shift 2 ;;
            --compatibility-risk) compatibility_risk=$2; shift 2 ;;
            --scope-rationale) scope_rationale=$2; shift 2 ;;
            --check-rationale) check_rationale=$2; shift 2 ;;
            --rollback-plan) rollback_plan=$2; shift 2 ;;
            --security-impact) security_impact=$2; shift 2 ;;
            --data-impact) data_impact=$2; shift 2 ;;
            --operational-impact) operational_impact=$2; shift 2 ;;
            --nfr-impact) nfr_impact=$2; shift 2 ;;
            --inspection-current) inspection_mode=CURRENT; shift ;;
            --inspection-skip-reason) [ "$#" -ge 2 ] || harness_die 2 "--inspection-skip-reason requires a value"; inspection_mode=SKIP; inspection_skip=$2; shift 2 ;;
            --module)
                old_ifs=$IFS; IFS='|' read -r module_id rationale <<EOF_MODULE
$2
EOF_MODULE
                IFS=$old_ifs
                [ -n "$module_id" ] && [ -n "$rationale" ] || harness_die 2 "--module requires ID|rationale"
                identifier_validate "$module_id" || harness_die 2 "invalid module identifier"
                printf '%s\t%s\n' "$module_id" "$(printf '%s' "$rationale" | tr '\t\r\n' '   ')" >>"$modules"
                shift 2 ;;
            --assumption)
                old_ifs=$IFS; IFS='|' read -r statement assumption_status <<EOF_ASSUMPTION
$2
EOF_ASSUMPTION
                IFS=$old_ifs
                [ -n "$statement" ] || harness_die 2 "--assumption requires TEXT|STATUS"
                [ -n "$assumption_status" ] || assumption_status=OPEN
                assumption_seq=$((assumption_seq + 1))
                printf 'ASM-%03d\t%s\t%s\n' "$assumption_seq" "$(printf '%s' "$statement" | tr '\t\r\n' '   ')" "$assumption_status" >>"$assumptions"
                shift 2 ;;
            --step)
                step_seq=$((step_seq + 1))
                printf 'STEP-%03d\t%s\n' "$step_seq" "$(printf '%s' "$2" | tr '\t\r\n' '   ')" >>"$steps"
                shift 2 ;;
            --evidence)
                old_ifs=$IFS; IFS='|' read -r claim_type claim_path claim_symbol claim_rationale <<EOF_EVIDENCE
$2
EOF_EVIDENCE
                IFS=$old_ifs
                [ -n "$claim_type" ] && [ -n "$claim_path" ] && [ -n "$claim_rationale" ] || harness_die 2 "--evidence requires TYPE|PATH|SYMBOL|RATIONALE"
                evidence_seq=$((evidence_seq + 1))
                printf 'UND-%03d\t%s\t%s\t%s\t%s\n' "$evidence_seq" "$claim_type" "$claim_path" "${claim_symbol:--}" "$(printf '%s' "$claim_rationale" | tr '\t\r\n' '   ')" >>"$evidence"
                shift 2 ;;
            *) rm -f "$modules" "$assumptions" "$steps" "$evidence"; harness_die 2 "unknown task understand option: $1" ;;
        esac
    done
    run_id=$(active_run_id 2>/dev/null) || { rm -f "$modules" "$assumptions" "$steps" "$evidence"; harness_die 3 "no active task"; }
    task_id=$(state_get "$run_id" TASK_ID)
    if [ -z "$inspection_mode" ]; then
        if [ "$(conf_get "$(task_dir "$task_id")/understanding.conf" PROJECT_MODE)" = brownfield ]; then
            rm -f "$modules" "$assumptions" "$steps" "$evidence"
            harness_die 2 "brownfield understanding requires --inspection-current or --inspection-skip-reason"
        fi
        inspection_mode=NONE
    fi
    task_record_understanding "$task_id" "$approved_by" "$current_behavior" "$entry_points" "$data_flow" "$dependencies" "$interface_impact" "$compatibility_risk" "$scope_rationale" "$check_rationale" "$rollback_plan" "$security_impact" "$data_impact" "$operational_impact" "$nfr_impact" "$modules" "$assumptions" "$steps" "$evidence" "$inspection_mode" "$inspection_skip" || {
        rm -f "$modules" "$assumptions" "$steps" "$evidence"; harness_die 3 "repository understanding is incomplete or invalid";
    }
    rm -f "$modules" "$assumptions" "$steps" "$evidence"
    printf 'Repository understanding recorded for %s\n' "$task_id"
}

task_show_cli() {
    local run_id task_id directory convention_count
    run_id=$(active_run_id 2>/dev/null) || harness_die 3 "no active task"
    task_id=$(state_get "$run_id" TASK_ID)
    directory=$(task_dir "$task_id")
    convention_count=$(awk 'NF {count++} END {print count+0}' "$directory/applicable-conventions.tsv" 2>/dev/null || printf 0)
    printf 'Task: %s\nTitle: %s\nGoal: %s\nProfile: %s\nState: %s\nApplicable conventions: %s\n' \
        "$task_id" "$(conf_get "$directory/spec.conf" TITLE)" "$(conf_get "$directory/spec.conf" GOAL)" \
        "$(conf_get "$directory/plan.conf" PROFILE)" "$(state_get "$run_id" STATE)" "$convention_count"
}

convention_rule_cli() {
    local mode rule_id category level source module_id path_pattern trigger enforcement check_id example_path rule_text approved_by languages file_types profiles risks phase order observation_id
    mode=$1; shift
    rule_id=""; category=""; level=""; source="DECLARED"; module_id="*"; path_pattern=""; trigger="ANY"; enforcement="MANUAL"; check_id=""; example_path=""; rule_text=""; approved_by=""
    languages="*"; file_types="*"; profiles="*"; risks="*"; phase="TEST"; order="100"; observation_id=""
    [ "$mode" = "candidate" ] && source="OBSERVED"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --id) rule_id=$2; shift 2 ;; --category) category=$2; shift 2 ;; --level) level=$2; shift 2 ;;
            --source) source=$2; shift 2 ;; --module) module_id=$2; shift 2 ;; --path) path_pattern=$2; shift 2 ;;
            --trigger) trigger=$2; shift 2 ;; --enforcement) enforcement=$2; shift 2 ;; --check) check_id=$2; shift 2 ;;
            --example) example_path=$2; shift 2 ;; --rule) rule_text=$2; shift 2 ;; --by) approved_by=$2; shift 2 ;;
            --language) languages=$2; shift 2 ;; --file-type) file_types=$2; shift 2 ;; --task-profile) profiles=$2; shift 2 ;;
            --risk) risks=$2; shift 2 ;; --phase) phase=$2; shift 2 ;; --order) order=$2; shift 2 ;; --observation) observation_id=$2; shift 2 ;;
            *) harness_die 2 "unknown convention rule option: $1" ;;
        esac
    done
    [ -n "$rule_id" ] && [ -n "$category" ] && [ -n "$level" ] && [ -n "$path_pattern" ] && [ -n "$rule_text" ] && [ -n "$approved_by" ] || harness_die 2 "convention rule is missing required values"
    if [ "$mode" = "active" ]; then
        case "$source" in DECLARED|EXTERNAL) ;; *) harness_die 2 "active rules require DECLARED or EXTERNAL source" ;; esac
        conventions_add_rule "$rule_id" "$category" "$level" "$source" "$module_id" "$path_pattern" "$trigger" "$enforcement" "$check_id" "$example_path" "$rule_text" "$approved_by" "$languages" "$file_types" "$profiles" "$risks" "$phase" "$order" || harness_die 3 "convention rule could not be added"
        printf 'Added convention %s\n' "$rule_id"
    else
        case "$source" in OBSERVED|INFERRED) ;; *) harness_die 2 "candidate rules require OBSERVED or INFERRED source" ;; esac
        [ -n "$observation_id" ] || harness_die 2 "candidate rules require --observation OBS-ID"
        conventions_add_candidate "$rule_id" "$category" "$level" "$source" "$module_id" "$path_pattern" "$trigger" "$enforcement" "$check_id" "$example_path" "$rule_text" "$approved_by" "$languages" "$file_types" "$profiles" "$risks" "$phase" "$order" "$observation_id" || harness_die 3 "convention candidate could not be added"
        printf 'Added convention candidate %s\n' "$rule_id"
    fi
}

run_public_tests() {
    local test_script output status filter verbose gate mode suite since explain artifact_root artifact bytes digest result label
    test_script=$HARNESS_DIR/tests/run.sh
    [ -x "$test_script" ] || harness_die 6 "consumer test suite is missing"
    gate=''; mode=''; filter=''; suite=''; since=''; verbose=0; explain=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --full) [ -z "$gate$mode" ] || harness_die 2 "--full conflicts with another gate or mode"; mode=full; shift ;;
            --gate)
                [ "$#" -ge 2 ] || harness_die 2 "--gate requires fast, lifecycle, adversarial, or release"
                case "$2" in fast|lifecycle|adversarial|release) ;; *) harness_die 2 "invalid test gate: $2" ;; esac
                [ -z "$gate$mode" ] || harness_die 2 "--gate conflicts with another gate or mode"
                gate=$2; shift 2 ;;
            --mode)
                [ "$#" -ge 2 ] || harness_die 2 "--mode requires focused, standard, full, or auto"
                test_mode_valid "$2" || harness_die 2 "invalid test mode: $2"
                [ -z "$gate$mode" ] || harness_die 2 "--mode conflicts with another gate or mode"
                mode=$2; shift 2 ;;
            --suite) [ "$#" -ge 2 ] || harness_die 2 "--suite requires a value"; suite=$2; shift 2 ;;
            --since) [ "$#" -ge 2 ] || harness_die 2 "--since requires a Git reference"; since=$2; shift 2 ;;
            --explain) explain=1; shift ;;
            --filter) [ "$#" -ge 2 ] || harness_die 2 "--filter requires a comma-separated case list"; filter=$2; shift 2 ;;
            --verbose) verbose=1; shift ;;
            *) harness_die 2 "unknown test option: $1" ;;
        esac
    done

    output=$(mktemp "${TMPDIR:-/tmp}/harness-public-tests.XXXXXX") || harness_die 6 "cannot create test output"
    set --
    if [ -n "$mode" ]; then set -- "$@" --mode "$mode"; elif [ -n "$gate" ]; then set -- "$@" --gate "$gate"; fi
    [ -z "$suite" ] || set -- "$@" --suite "$suite"
    [ -z "$since" ] || set -- "$@" --since "$since"
    [ "$explain" -eq 0 ] || set -- "$@" --explain
    [ -z "$filter" ] || set -- "$@" --filter "$filter"
    [ "$HARNESS_JSON_MODE" = 1 ] && set -- "$@" --json

    bash "$test_script" "$@" >"$output" 2>&1
    status=$?
    if [ "$status" -eq 0 ]; then
        if [ "$verbose" -eq 1 ] || [ "$explain" -eq 1 ]; then cat "$output"; else tail -n 1 "$output"; fi
        rm -f "$output"
        return 0
    fi

    label=${mode:-${gate:-fast}}
    artifact_root=${HARNESS_TEST_ARTIFACT_DIR:-${TMPDIR:-/tmp}/agent-harness-test-artifacts}
    [ ! -L "$artifact_root" ] || { rm -f "$output"; harness_die 6 "test artifact directory must not be a symlink"; }
    mkdir -p "$artifact_root" || { rm -f "$output"; harness_die 6 "cannot create test artifact directory"; }
    chmod 700 "$artifact_root" 2>/dev/null || true
    artifact=$(mktemp "$artifact_root/test-$label.XXXXXX") || { rm -f "$output"; harness_die 6 "cannot create test artifact"; }
    mv "$output" "$artifact" || { rm -f "$output" "$artifact"; harness_die 6 "cannot retain test artifact"; }
    chmod 600 "$artifact" 2>/dev/null || true
    bytes=$(wc -c <"$artifact" | tr -d ' ')
    digest=$(sha256_file "$artifact") || harness_die 6 "cannot hash test artifact"
    if [ "$verbose" -eq 1 ]; then
        cat "$artifact"
    elif [ "$HARNESS_JSON_MODE" = "1" ]; then
        result=FAIL; [ "$status" -ne 2 ] || result=ERROR
        printf '{"result":"%s","mode":"%s","gate":"%s","exit_code":%s,"summary":"test execution failed; inspect the retained artifact","artifact":{"path":"%s","bytes":%s,"sha256":"%s"}}\n' \
            "$result" "$(json_escape "${mode:-legacy-gate}")" "$(json_escape "${gate:-$label}")" "$status" "$(json_escape "$artifact")" "$bytes" "$digest"
    else
        printf 'Test selection: %s\nResult: FAIL\nExit code: %s\nFull output: %s\nOutput bytes: %s\nOutput SHA-256: %s\n' \
            "$label" "$status" "$artifact" "$bytes" "$digest"
    fi
    return "$status"
}

validate_cli_option_arity "$@"
strip_json_flag "$@"
set -- "${FILTERED_ARGS[@]}"
command_name=${1:-help}
[ "$#" -eq 0 ] || shift

# Read-only commands must not materialize runtime or project state. Mutating
# commands initialize the repository-owned data layout explicitly.
case "$command_name" in
    status|next|audit|doctor|test|help|-h|--help) ;;
    context)
        [ "${1:-show}" = "show" ] || harness_ensure_layout || harness_die 4 "cannot initialize harness data layout"
        ;;
    *) harness_ensure_layout || harness_die 4 "cannot initialize harness data layout" ;;
esac

case "$command_name" in
    status) workflow_status ;;
    next) workflow_next "$@" ;;
    task)
        sub=${1:-}
        [ "$#" -eq 0 ] || shift
        case "$sub" in
            create) task_create_cli "$@" ;;
            understand) task_understand_cli "$@" ;;
            show) task_show_cli ;;
            approval-subject)
                [ "$#" -eq 0 ] || harness_die 2 "task approval-subject takes no options"
                task_prepare_approval_subject || harness_die 3 "approval subject could not be prepared"
                ;;
            clarify)
                [ "${1:-}" = "--question" ] && [ "$#" -ge 2 ] || harness_die 2 "task clarify requires --question"
                id=$(task_request_clarification "$2") || harness_die 3 "clarification request failed"
                printf 'Question ID: %s\n' "$id" ;;
            answer)
                question_id=""; answer=""
